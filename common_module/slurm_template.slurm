#!/bin/bash
# ============================================================
#  SLURM Job Template — antioch-vs/common_module
# ============================================================
#  This file is a template. Placeholders (<<...>>) are replaced
#  by autosubmit.py at submission time using cluster.conf.
#  Do NOT edit this file manually unless you change the layout.
# ============================================================

#SBATCH --job-name=<<JOB_NAME>>
#SBATCH --output=<<OUTPUT_DIR>>/slurm-<<JOB_NAME>>-%j.out # Output File
#SBATCH --error=<<OUTPUT_DIR>>/slurm-<<JOB_NAME>>-%j.err # Error File
#SBATCH --partition=<<PARTITION>>
<<GPUS_LINE>>
#SBATCH --time=<<TIME>>
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=<<NTASKS_PER_NODE>>
#SBATCH --mem=<<MEM>> # MB
<<ACCOUNT_LINE>>
<<QOS_LINE>>

# <<EXTRA_SBATCH>>

# ---- Environment ---------------------------------------------------------
export SLURM_SUBMIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load modules if a module-list was supplied
if [ -n "<<MODULES>>" ]; then
    module purge
    for mod in <<MODULES>>; do
        module load "$mod"
    done
fi

# Activate conda environment if specified
if [ -n "<<CONDA_ENV>>" ]; then
    # Try common locations; adjust PATH_TO_CONDA if needed
    export PATH_TO_CONDA="${PATH_TO_CONDA:-$(which conda | xargs dirname | xargs dirname 2>/dev/null)}"
    if [ -n "$PATH_TO_CONDA" ] && [ -x "${PATH_TO_CONDA}/bin/conda" ]; then
        eval "$(${PATH_TO_CONDA}/bin/conda shell.bash hook)" 2>/dev/null
        conda activate "<<CONDA_ENV>>"
    fi
fi

# ---- Run the user script -------------------------------------------------
echo "=== Job started at $(date -u '+%Y-%m-%d %H:%M:%S UTC') ==="
echo "=== SLURM_JOB_ID  = $SLURM_JOB_ID ==="
echo "=== Working dir   = <<WORK_DIR>> ==="

cd "<<WORK_DIR>>"
bash "<<USER_SCRIPT>>"
EXIT_CODE=$?

echo "=== Job finished at $(date -u '+%Y-%m-%d %H:%M:%S UTC') ==="
echo "=== Exit code     = $EXIT_CODE ==="

exit $EXIT_CODE
